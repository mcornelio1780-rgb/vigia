# Conexión a PostgreSQL/PostGIS (docker-compose la expone en localhost:5432)
DATABASE_URL=postgres://vigia:vigia@localhost:5432/vigia
# Puerto de la API
PORT=4000

# Autenticación de administrador (cambiar en producción)
ADMIN_PASSWORD=vigia-admin
AUTH_SECRET=dev-secret-change-me

