# Conexión a PostgreSQL/PostGIS (docker-compose la expone en localhost:5432)
DATABASE_URL=postgres://vigia:vigia@localhost:5432/vigia
# TLS para Postgres gestionado (Render, Neon, Supabase, Fly): se activa con
# DATABASE_SSL=true o si la URL incluye sslmode=require. En local queda apagado.
# DATABASE_SSL=true
# Puerto de la API
PORT=4000

# Autenticación de administrador para consultar los leads (cambiar en producción)
ADMIN_PASSWORD=vigia-admin
AUTH_SECRET=dev-secret-change-me

# NASA FIRMS: MAP_KEY gratuita para focos de incendio en vivo (opcional).
# Consíguela en https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Sin ella, el dashboard usa el riesgo de incendio de demostración.
# FIRMS_MAP_KEY=
# FIRMS_SOURCE=VIIRS_SNPP_NRT
